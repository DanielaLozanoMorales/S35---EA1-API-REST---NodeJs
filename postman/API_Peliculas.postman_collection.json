    {
      "name": "01. Listar géneros predefinidos",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/generos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "generos"
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"tag\", String(Date.now()));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Existen 5 géneros iniciales\", () => pm.expect(pm.response.json().total).to.be.at.least(5));",
              "pm.collectionVariables.set(\"generoId\", pm.response.json().datos.find(x => x.nombre === \"Acción\").id);"
            ]
          }
        }
      ]
    },
